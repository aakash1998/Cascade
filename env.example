# ============================================================
# CASCADE — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your keys
# NEVER commit .env to Git — it is in .gitignore
# ============================================================

# ── LLM PROVIDERS ───────────────────────────────────────────

# Anthropic Claude — primary LLM for critical agents
# Get key: console.anthropic.com
# Set to "none" to run fully free on Groq
ANTHROPIC_API_KEY=your_key_here

# Groq — free · Llama 3.3 70B · all domain agents
# Get key: console.groq.com
GROQ_API_KEY=your_key_here

# NVIDIA NIM — free fallback · 40 RPM
# Get key: build.nvidia.com (join NVIDIA Developer Program)
NVIDIA_NIM_API_KEY=your_key_here

# Google Gemini Flash — free fallback · 250 req/day
# Get key: aistudio.google.com
GOOGLE_API_KEY=your_key_here

# ── NEWS SOURCES ─────────────────────────────────────────────

# NewsAPI — global headlines · 100 calls/day free
# Get key: newsapi.org/register
NEWS_API_KEY=your_key_here

# The Guardian — quality journalism · completely free
# Get key: open-platform.theguardian.com/access
GUARDIAN_API_KEY=your_key_here

# New York Times — archive + search · completely free
# Get key: developer.nytimes.com
NYTIMES_API_KEY=MyzVdVhztN9zE66fqQEwhjZIcc0ztQ90LPbwIoCeaNA0xzA4
NYTIMES_SECRET_KEY=CtGhzkolVSz06hEem36JOOUVdwaNH4iGB476dh9jZypv2WGJfOBD8kuvcZ8BECLI

# MediaStack — live news · 50 countries · 500 calls/month free
# Get key: mediastack.com
MEDIASTACK_API_KEY=a32919fd95784541836dbdf56c9483fe

# Currents API — news + categories · 600 calls/day free
# Get key: currentsapi.services
CURRENTS_API_KEY=nHdlaSKMUkEmVAKVrqnNIQoX4J4MBAQfq2HZdld0jDkdv1LJ

# GNews — Google News aggregator · 100 calls/day free
# Get key: gnews.io
GNEWS_API_KEY=your_key_here

# The News API — aggregated global news · free tier
# Get key: thenewsapi.com
THE_NEWS_API_KEY=your_key_here

# RSS feeds — no key needed · direct from publishers
# BBC, Reuters, AP, Al Jazeera, Financial Times, Bloomberg
# These are fetched directly in rss_feeds.py
RSS_ENABLED=true

# ── ECONOMIC + FINANCIAL DATA ────────────────────────────────

# FRED (US Federal Reserve) — 800k+ series · completely free
# Get key: fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=87c782e127e9ed2e6a3b1bd464e13ce2

# Finnhub — stocks · forex · news sentiment · 60 calls/min free
# Get key: finnhub.io/register
FINNHUB_API_KEY=your_key_here

# Alpha Vantage — 60+ indicators · commodities · 25 calls/day free
# Get key: alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=your_key_here

# Financial Modeling Prep — GDP · inflation · treasury · free tier
# Get key: financialmodelingprep.com/developer
FMP_API_KEY=maoNhfP5N8GPzcDF6zCQkUh4zBsZcSxi

# World Bank — 196 countries · completely free · no key needed
WORLD_BANK_ENABLED=true

# IMF Data API — global financial stability · completely free · no key needed
IMF_ENABLED=true

# OECD Data — OECD countries · economic outlook · completely free · no key needed
OECD_ENABLED=true

# DBnomics — 20M+ indicators · 80+ agencies · completely free · no key needed
DBNOMICS_ENABLED=true

# BLS (US Bureau of Labor Statistics) — employment · wages · completely free
# No key required but register for higher limits
BLS_API_KEY=1223beff69f342f4aaeebe290061c887

# Eurostat — EU economic data · completely free · no key needed
EUROSTAT_ENABLED=true

# ── GEOPOLITICAL + CONFLICT DATA ────────────────────────────

# GDELT Project — every world event · updated every 15 minutes · completely free
# No key needed
GDELT_ENABLED=true

# ACLED (Armed Conflict Location and Event Data)
# Free for research/non-commercial — register at acleddata.com
ACLED_API_KEY=your_key_here
ACLED_EMAIL=your_email_here

# Uppsala Conflict Data Program (UCDP) — completely free · no key needed
UCDP_ENABLED=true

# Global Terrorism Database — completely free · no key needed
GTD_ENABLED=true

# UNODC — crime · drugs · corruption · completely free · no key needed
UNODC_ENABLED=true

# ── SOCIAL SIGNALS ───────────────────────────────────────────

# Reddit (PRAW) — public posts · sentiment · subreddits
# Get credentials: reddit.com/prefs/apps → create app (script type)
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USER_AGENT=cascade_ripple_engine_v1

# Google Trends (Pytrends) — no key needed · completely free
GOOGLE_TRENDS_ENABLED=true

# Hacker News — completely free · no key needed
HN_ENABLED=true

# Wikipedia Pageviews — public attention proxy · completely free · no key needed
WIKIPEDIA_ENABLED=true

# ── TRADE + SUPPLY CHAIN ────────────────────────────────────

# UN Comtrade — global trade flows · limited free calls
# Get key: comtradeplus.un.org
UN_COMTRADE_API_KEY=your_key_here

# World Trade Organization — tariff data · completely free · no key needed
WTO_ENABLED=true

# UNCTAD — trade + development statistics · completely free · no key needed
UNCTAD_ENABLED=true

# MarineTraffic — ship positions · port activity · free limited tier
# Get key: marinetraffic.com/en/p/api-services
MARINE_TRAFFIC_API_KEY=your_key_here_optional

# ── CLIMATE + ENVIRONMENT ───────────────────────────────────

# Open-Meteo — weather · climate · historical · completely free · no key needed
OPEN_METEO_ENABLED=true

# NOAA Climate Data — temperature · precipitation · completely free
# Get token: ncdc.noaa.gov/cdo-web/token
NOAA_TOKEN=your_token_here

# NASA Earthdata — satellite · environmental · completely free
# Get key: urs.earthdata.nasa.gov
NASA_API_KEY=your_key_here

# Global Forest Watch — deforestation · completely free · no key needed
GFW_ENABLED=true

# ── LABOUR + JOBS ────────────────────────────────────────────

# BLS JOLTS — job openings · quits · layoffs · completely free
# (uses BLS_API_KEY above)
BLS_JOLTS_ENABLED=true

# ILO (International Labour Organization) — global employment · completely free
ILO_ENABLED=true

# Layoffs.fyi — public tech layoff tracker · scraped · completely free
LAYOFFS_FYI_ENABLED=true

# ── GOVERNMENT + POLICY ─────────────────────────────────────

# data.gov — US open government data · completely free · no key needed
DATA_GOV_ENABLED=true

# EU Open Data Portal — completely free · no key needed
EU_OPENDATA_ENABLED=true

# USPTO Patents API — patent filings · innovation signals · completely free
# Get key: developer.uspto.gov
USPTO_API_KEY=your_key_here_optional

# OpenSecrets — US political spending · lobbying · completely free
# Get key: opensecrets.org/api/admin
OPENSECRETS_API_KEY=your_key_here_optional

# ── HEALTH + WELLBEING ──────────────────────────────────────

# WHO Global Health Observatory — completely free · no key needed
WHO_ENABLED=true

# Our World in Data — health · poverty · wellbeing · completely free · no key needed
OWID_ENABLED=true

# CDC Wonder — US public health data · completely free · no key needed
CDC_ENABLED=true

# ── REFERENCE + GEOGRAPHY ───────────────────────────────────

# REST Countries — country data · currencies · completely free · no key needed
REST_COUNTRIES_ENABLED=true

# GeoNames — geographic data · timezone · free with account
# Register: geonames.org/login
GEONAMES_USERNAME=your_username_here

# ── PIPELINE SETTINGS ────────────────────────────────────────

# Maximum agents to spin up per query (hard cap)
MAX_AGENTS=33

# Complexity score cap (lower = fewer agents = lower cost)
# 1.0-5.0 scale — set to 3.5 to reduce cost by ~30%
MAX_COMPLEXITY_OVERRIDE=5.0

# Session settings
SESSION_TTL_HOURS=2
MAX_CONVERSATION_TURNS=10

# Daily spend cap in USD — switches to free LLMs when hit
DAILY_BUDGET_USD=2.00

# Rate limiting (for hosted demo)
RATE_LIMIT_PER_IP_PER_DAY=3

# Content filtering
ENABLE_CONTENT_FILTER=true

# ── STORAGE ──────────────────────────────────────────────────

# SQLite database path for prediction logging
PREDICTION_DB_PATH=./data/predictions.db

# Snapshot storage path for shareable links
SNAPSHOTS_PATH=./data/snapshots/

# ── NOTIFICATIONS (optional) ────────────────────────────────

# Slack webhook for system alerts (not user-facing)
# Get from: api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=your_webhook_here_optional

# SMTP for email alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email_here_optional
SMTP_PASSWORD=your_password_here_optional
ALERT_EMAIL_TO=your_email_here_optional

# ── OPTIONAL INTEGRATIONS ────────────────────────────────────

# Notion — for optional docs/ticket integration
# Get token: notion.so/my-integrations
NOTION_API_TOKEN=your_token_here_optional
NOTION_DATABASE_ID=your_database_id_optional

# LangSmith — agent tracing (highly recommended)
# Get key: smith.langchain.com
LANGSMITH_API_KEY=your_key_here_optional
LANGSMITH_PROJECT=cascade-ripple-engine

# ── RUNNING MODES ────────────────────────────────────────────

# Set to "true" to run fully locally with mock data (no API calls)
LOCAL_DEV_MODE=false

# Set to "true" to use only free LLMs (Groq + NVIDIA NIM + Gemini)
FREE_MODE_ONLY=false

# Set to "true" to enable verbose agent logging
DEBUG_AGENTS=false
